    - target: {fileID: 9016376206743260124, guid: 86e65480d18de5f48bab951314ce8b97, type: 3}
      propertyPath: noGloveFailMessage
      value: "\uBCF4\uD638\uAD6C \uBBF8\uCC29\uC6A9 \uC0AC\uACE0\r\n\r\n\uBCF4\uD638\uAD6C\uB97C
        \uCC29\uC6A9\uD558\uC9C0 \uC54A\uC740 \uC0C1\uD0DC\uC5D0\uC11C \uC791\uC5C5\uC744
        \uC9C4\uD589\uD558\uC5EC \uC0AC\uACE0\uAC00 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4.\r\n\r\n\uACE0\uC6A9\uB178\uB3D9\uBD80
        \uC0B0\uC5C5\uC7AC\uD574 \uD1B5\uACC4\uC5D0 \uB530\uB974\uBA74 2024\uB144
        \uC7AC\uD574\uC870\uC0AC \uB300\uC0C1 \uC0AC\uACE0\uC0AC\uB9DD\uC790\uB294
        589\uBA85\uC73C\uB85C, \uCD5C\uADFC\uC5D0\uB3C4 \uB9E4\uB144 \uC57D 600\uBA85
        \uC218\uC900\uC758 \uB178\uB3D9\uC790\uAC00 \uC0B0\uC5C5\uD604\uC7A5 \uC0AC\uACE0\uB85C
        \uC0AC\uB9DD\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uB610\uD55C \uACE0\uC6A9\uB178\uB3D9\uBD80
        \uC810\uAC80 \uC790\uB8CC\uC5D0\uC11C\uB294 \uAC1C\uC778\uBCF4\uD638\uAD6C
        \uBBF8\uCC29\uC6A9\uC774 \uC81C\uC870\uC5C5 \uC0AC\uC5C5\uC7A5 9.8%, \uAC74\uC124\uC5C5
        \uC0AC\uC5C5\uC7A5 21.4%\uC5D0\uC11C \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n\uB4DC\uB9B4
        \uC791\uC5C5 \uC911 \uBC1C\uC0DD\uD558\uB294 \uD30C\uD3B8, \uBD84\uC9C4,
        \uBE44\uC0B0\uBB3C\uC740 \uB208\uACFC \uC190\uC5D0 \uC9C1\uC811\uC801\uC778
        \uC0C1\uD574\uB97C \uC904 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBCF4\uD638\uAD6C
        \uCC29\uC6A9\uC740 \uC120\uD0DD\uC774 \uC544\uB2C8\uB77C \uC0DD\uBA85\uC744
        \uC9C0\uD0A4\uB294 \uAC00\uC7A5 \uAE30\uBCF8\uC801\uC778 \uC548\uC804 \uC808\uCC28\uC785\uB2C8\uB2E4."
      objectReference: {fileID: 0}
