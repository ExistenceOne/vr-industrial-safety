  m_Script: {fileID: 11500000, guid: 38c076fbe2a60d04691a57b1c5775371, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HammerFragmentEyeAccident
  playerHead: {fileID: 35624882}
  bloodEffectPrefab: {fileID: 3723186245368743947, guid: a46e58915c3fa5b4f9fd597d3355860a, type: 3}
  failMessage: "\uD30C\uD3B8 \uBE44\uC0B0 \uC0AC\uACE0 \uBC1C\uC0DD\r\n\r\n\uBABB\uC774
    \uAE30\uC6B8\uC5B4\uC9C4 \uC0C1\uD0DC\uC5D0\uC11C \uB9DD\uCE58\uB85C \uD0C0\uACA9\uD558\uC5EC\r\n\uAE08\uC18D
    \uD30C\uD3B8\uC774 \uB208 \uBC29\uD5A5\uC73C\uB85C \uD280\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC791\uC5C5
    \uC911 \uB208 \uBD80\uC0C1\uC758 \uC57D 70%\uB294 \uB0A0\uC544\uC624\uAC70\uB098
    \uB5A8\uC5B4\uC9C0\uB294 \uBB3C\uCCB4,\r\n\uB610\uB294 \uBD88\uAF43\uC774 \uB208\uC5D0
    \uCDA9\uB3CC\uD558\uBA74\uC11C \uBC1C\uC0DD\uD55C \uAC83\uC73C\uB85C \uBCF4\uACE0\uB429\uB2C8\uB2E4.\r\n\r\n\uC2E4\uC81C
    \uC0AC\uB840\uB85C, \uBCF4\uD638\uC548\uACBD \uC5C6\uC774 \uB9DD\uCE58\uC9C8\uC744
    \uD558\uB358 \uC791\uC5C5\uC790\uAC00\r\n\uAE08\uC18D \uD30C\uD3B8\uC5D0 \uB208\uC744
    \uB9DE\uC544 \uC2DC\uC57C \uD750\uB9BC\uACFC \uD1B5\uC99D\uC744 \uD638\uC18C\uD55C
    \uC0AC\uB840\uAC00 \uBCF4\uACE0\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC791\uC740
    \uD30C\uD3B8\uC774\uB77C\uB3C4 \uAC01\uB9C9 \uC190\uC0C1, \uC548\uAD6C \uAD00\uD1B5\uC0C1,\r\n\uC2DC\uB825
    \uC800\uD558\uB85C \uC774\uC5B4\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uB9DD\uCE58
    \uC791\uC5C5 \uC804\uC5D0\uB294 \uBC18\uB4DC\uC2DC \uBCF4\uC548\uACBD\uC744 \uCC29\uC6A9\uD558\uACE0,\r\n\uBABB\uC744
    \uC218\uC9C1\uC73C\uB85C \uACE0\uC815\uD55C \uC0C1\uD0DC\uC5D0\uC11C \uD0C0\uACA9\uD574\uC57C
    \uD569\uB2C8\uB2E4."
