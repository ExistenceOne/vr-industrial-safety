      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 2566247596086612393, guid: 689425acc2d0de442a0d9f12bf8746b4, type: 3}
      propertyPath: overDrillFailSound
      value: 
      objectReference: {fileID: 8300000, guid: 280dba4920a13d046865e2b703f1eab8, type: 3}
    - target: {fileID: 2566247596086612393, guid: 689425acc2d0de442a0d9f12bf8746b4, type: 3}
      propertyPath: overDrillFailMessage
      value: "\uC9C0\uC815 \uAE4A\uC774\uB97C \uCD08\uACFC\uD558\uC5EC \uCC9C\uACF5\uD588\uC2B5\uB2C8\uB2E4.\r\n\uBCBD
        \uB0B4\uBD80 \uC804\uC120\uC744 \uC190\uC0C1\uC2DC\uCF1C \uAC10\uC804 \uC0AC\uACE0\uAC00
        \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4.\r\n\r\n2024\uB144 \uAD6D\uB0B4 \uAC10\uC804\uC0AC\uACE0
        \uC778\uBA85\uD53C\uD574\uB294 371\uBA85,\r\n\uC0AC\uB9DD\uC790\uB294 28\uBA85\uC73C\uB85C
        \uC9D1\uACC4\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n\uBCBD \uB0B4\uBD80 \uC804\uC120\uC740
        \uC721\uC548\uC73C\uB85C \uD655\uC778\uD558\uAE30 \uC5B4\uB835\uAE30 \uB54C\uBB38\uC5D0\r\n\uAE4A\uC774
        \uD655\uC778 \uC5C6\uB294 \uCC9C\uACF5\uC740 \uC791\uC740 \uBD80\uC8FC\uC758\uB3C4
        \uC911\uB300 \uC0AC\uACE0\uB85C \uC774\uC5B4\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 2566247596086612393, guid: 689425acc2d0de442a0d9f12bf8746b4, type: 3}
