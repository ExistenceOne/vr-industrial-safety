      objectReference: {fileID: 671169484}
    - target: {fileID: 2566247596086612393, guid: 689425acc2d0de442a0d9f12bf8746b4, type: 3}
      propertyPath: successMessage
      value: "\uB4DC\uB9B4 \uC2E4\uC2B5 \uC644\uB8CC!\n\n\uC9C0\uC815\uB41C \uAE4A\uC774\uAE4C\uC9C0\uB9CC
        \uC548\uC804\uD558\uAC8C \uCC9C\uACF5\uD588\uC2B5\uB2C8\uB2E4.\n\n\uBCBD
        \uB0B4\uBD80 \uC804\uC120\uC740 \uB208\uC73C\uB85C \uD655\uC778\uD558\uAE30
        \uC5B4\uB835\uAE30 \uB54C\uBB38\uC5D0\n\uAE4A\uC774 \uC870\uC808 \uC5C6\uC774
        \uCC9C\uACF5\uD558\uBA74 \uAC10\uC804 \uC0AC\uACE0\uB85C \uC774\uC5B4\uC9C8
        \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC791\uC5C5 \uC804 \uCC9C\uACF5 \uAE4A\uC774\uB97C
        \uD655\uC778\uD558\uACE0,\n\uBB34\uB9AC\uD558\uAC8C \uAE4A\uAC8C \uB6AB\uC9C0
        \uC54A\uB294 \uAC83\uC774 \uC911\uC694\uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 2566247596086612393, guid: 689425acc2d0de442a0d9f12bf8746b4, type: 3}
      propertyPath: rightController
      value: 
      objectReference: {fileID: 1206948163}
    - target: {fileID: 2566247596086612393, guid: 689425acc2d0de442a0d9f12bf8746b4, type: 3}
      propertyPath: trembleDuration
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 2566247596086612393, guid: 689425acc2d0de442a0d9f12bf8746b4, type: 3}
      propertyPath: trembleMagnitude
      value: 0.015
      objectReference: {fileID: 0}
    - target: {fileID: 2566247596086612393, guid: 689425acc2d0de442a0d9f12bf8746b4, type: 3}
      propertyPath: drillInteractable
      value: 
