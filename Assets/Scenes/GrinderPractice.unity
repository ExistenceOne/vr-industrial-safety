--- !u!1001 &8123088211884265139
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 1388673888476765185, guid: 51c6dcc7aeffe2342bb8d940f9f0e757, type: 3}
      propertyPath: failMessage
      value: "\uD0A5\uBC31 \uC0AC\uACE0 \uBC1C\uC0DD\r\n\r\n\uADF8\uB77C\uC778\uB354
        \uB0A0\uC774 \uC7AC\uB8CC\uC5D0 \uB07C\uC774\uAC70\uB098 \uBB34\uB9AC\uD55C
        \uC555\uB825\uC774 \uAC00\uD574\uC838\r\n\uACF5\uAD6C\uAC00 \uC791\uC5C5\uC790
        \uBC29\uD5A5\uC73C\uB85C \uD295\uACA8 \uB098\uC654\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC2E4\uC81C
        \uC0AC\uB840\uB85C, \uD55C \uC80A\uC740 \uACAC\uC2B5 \uC791\uC5C5\uC790\uAC00
        9\uC778\uCE58 \uADF8\uB77C\uC778\uB354\uB97C \uC0AC\uC6A9\uD558\uB358 \uC911
        \uACF5\uAD6C\uAC00 \uD0A5\uBC31\uB418\uC5B4 \uBCF5\uBD80, \uC0AC\uD0C0\uAD6C\uB2C8,
        \uB2E4\uB9AC\uC5D0 \uC2EC\uAC01\uD55C \uBD80\uC0C1\uC744 \uC785\uC740 \uC0AC\uACE0\uAC00
        \uBCF4\uACE0\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n\uB610 \uB2E4\uB978 \uC0AC\uB840\uC5D0\uC11C\uB294
        \uC791\uC5C5\uC790\uAC00 \uC0AC\uB2E4\uB9AC \uC704\uC5D0\uC11C 9\uC778\uCE58
        \uADF8\uB77C\uC778\uB354\uB85C \uCCA0\uACE8\uC744 \uC808\uB2E8\uD558\uB358
        \uC911 \uADF8\uB77C\uC778\uB354\uAC00 \uD295\uACA8 \uC5BC\uAD74\uBD80\uD130
        \uBAA9, \uAC00\uC2B4\uAE4C\uC9C0 \uC774\uC5B4\uC9C0\uB294 \uAE4A\uC740 \uC5F4\uC0C1\uC744
        \uC785\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n\uD0A5\uBC31\uC740 \uC21C\uAC04\uC801\uC73C\uB85C
        \uBC1C\uC0DD\uD558\uBA70 \uC190, \uD314, \uC5BC\uAD74, \uBAB8\uD1B5 \uBD80\uC704\uC5D0\r\n\uC2EC\uAC01\uD55C
        \uC808\uC0C1, \uACE8\uC808, \uC808\uB2E8 \uC0AC\uACE0\uB97C \uC720\uBC1C\uD560
        \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC791\uC5C5 \uC911\uC5D0\uB294 \uBB34\uB9AC\uD558\uAC8C
        \uD798\uC744 \uC8FC\uC9C0 \uB9D0\uACE0\r\n\uADF8\uB77C\uC778\uB354\uB97C
        \uC591\uC190\uC73C\uB85C \uB2E8\uB2E8\uD788 \uC7A1\uC740 \uC0C1\uD0DC\uC5D0\uC11C\r\n\uC808\uB2E8
        \uBC29\uD5A5\uACFC \uC548\uC804\uAC70\uB9AC\uB97C \uBC18\uB4DC\uC2DC \uC720\uC9C0\uD574\uC57C
        \uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 1388673888476765185, guid: 51c6dcc7aeffe2342bb8d940f9f0e757, type: 3}
      propertyPath: countdownText
      value: 
      objectReference: {fileID: 1930958170}
    - target: {fileID: 1983092055306384991, guid: 51c6dcc7aeffe2342bb8d940f9f0e757, type: 3}
      propertyPath: m_LocalPosition.x
      value: -3.388
      objectReference: {fileID: 0}
    - target: {fileID: 1983092055306384991, guid: 51c6dcc7aeffe2342bb8d940f9f0e757, type: 3}
      propertyPath: m_LocalPosition.z
      value: 0.952
      objectReference: {fileID: 0}
    - target: {fileID: 3216511531750888659, guid: 51c6dcc7aeffe2342bb8d940f9f0e757, type: 3}
      propertyPath: m_Name
      value: Room
      objectReference: {fileID: 0}
    - target: {fileID: 3529395472871797945, guid: 51c6dcc7aeffe2342bb8d940f9f0e757, type: 3}
      propertyPath: failMessage
      value: "\uADF8\uB77C\uC778\uB354 \uC808\uB2E8 \uC0AC\uACE0 \uBC1C\uC0DD\r\n\r\n\uD68C\uC804
        \uC911\uC778 \uADF8\uB77C\uC778\uB354 \uB0A0\uC5D0 \uC190\uC774 \uC811\uCD09\uD588\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC751\uAE09\uC2E4
        \uB0B4\uC6D0 \uC0AC\uB840 \uBD84\uC11D\uC5D0\uC11C \uADF8\uB77C\uC778\uB354
        \uC0AC\uC6A9 \uC911 \uAC00\uC7A5 \uB9CE\uC774 \uB2E4\uCE5C \uBD80\uC704\uB294
        \uC190\uC73C\uB85C,\r\n\uC804\uCCB4 \uADF8\uB77C\uC778\uB354 \uC190\uC0C1
        \uC0AC\uB840\uC758 \uC57D 46.4%\uB97C \uCC28\uC9C0\uD588\uC2B5\uB2C8\uB2E4.\r\n\r\n\uB610\uD55C
        \uADF8\uB77C\uC778\uB354 \uAD00\uB828 \uC785\uC6D0 \uD658\uC790 \uC5F0\uAD6C\uC5D0\uC11C\uB294
        \uC0AC\uACE0 \uC6D0\uC778\uC758 \uC57D 64.6%\uAC00\r\n\uD68C\uC804 \uB0A0\uACFC\uC758
        \uC9C1\uC811 \uC811\uCD09\uC73C\uB85C \uBCF4\uACE0\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n\uADF8\uB77C\uC778\uB354
        \uB0A0\uC740 \uACE0\uC18D\uC73C\uB85C \uD68C\uC804\uD558\uAE30 \uB54C\uBB38\uC5D0\r\n\uC9E7\uC740
        \uC811\uCD09\uB9CC\uC73C\uB85C\uB3C4 \uAE4A\uC740 \uC808\uC0C1, \uACE8\uC808,
        \uC190\uAC00\uB77D \uC808\uB2E8 \uC0AC\uACE0\uB85C \uC774\uC5B4\uC9C8 \uC218
        \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC791\uC5C5 \uC911\uC5D0\uB294 \uC808\uB2E8\uBD80
        \uADFC\uCC98\uC5D0 \uC190\uC744 \uB450\uC9C0 \uB9D0\uACE0,\r\n\uBCF4\uD638\uC7A5\uAC11
        \uCC29\uC6A9\uACFC \uC548\uC804\uAC70\uB9AC \uD655\uBCF4\uB97C \uBC18\uB4DC\uC2DC
        \uC9C0\uCF1C\uC57C \uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 3529395472871797945, guid: 51c6dcc7aeffe2342bb8d940f9f0e757, type: 3}
      propertyPath: leftHandTransform
      value: 
      objectReference: {fileID: 245693154}
